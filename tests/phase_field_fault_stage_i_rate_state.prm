# Stage-I fresh Theta initialization and adiabatic-pressure rate-and-state path.
# Enable if: ASPECT_WITH_VORO
# MPI: 2

include $ASPECT_SOURCE_DIR/tests/phase_field_fault_stage_i.prm

subsection Compositional fields
  set Number of fields            = 5
  set Names of fields             = tau_xx, tau_yy, tau_xy, rock, theta_initial
  set Types of fields             = stress, stress, stress, chemical composition, generic
  set Compositional field methods = particles, particles, particles, particles, particles
  set Mapped particle properties  = tau_xx:maxwell stress[0], tau_yy:maxwell stress[1], tau_xy:maxwell stress[2], rock:initial composition[0], theta_initial:phase field fault state[0]
end

subsection Initial composition model
  subsection Function
    set Function expression = 4e6; -4e6+8e6*x; 1e6; 0.1+0.8*y; 2e4+1e4*x
  end
end

subsection Material model
  subsection Phase field fault
    set Friction law                    = rate state
    set Reference slip rate             = 1e-6
    set Minimum slip rate               = 1e-12
    set Characteristic slip distance    = 0.04
    set Reference friction coefficients = 0, 0
    set Direct effect parameters        = 0.02, 0.02
    set Evolution effect parameters     = 0.04, 0.04
    set Use regularized formulation     = true
    set Use adiabatic pressure in fault friction = true
  end
end

subsection Particles
  subsection Initial composition
    set List of field names = rock, theta_initial
  end
end
