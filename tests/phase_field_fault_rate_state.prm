# Verify that Stage E preserves the stateful rate-and-state law, exact aging
# update, derivative, timestep restriction, and API dispatch.

include $ASPECT_SOURCE_DIR/tests/phase_field_fault_maxwell_stress_initialization.prm

subsection Compositional fields
  set Number of fields            = 5
  set Names of fields             = tau_xx, tau_yy, tau_xy, weak, strong
  set Types of fields             = stress, stress, stress, chemical composition, chemical composition
  set Compositional field methods = particles, particles, particles, static, static
end

subsection Initial composition model
  subsection Function
    set Function expression = x+2*y; 3*x-y; 5; 0.3; 0.5
  end
end

subsection Material model
  subsection Phase field fault
    set Friction law                    = rate state
    set Reference slip rate             = 1e-6
    set Minimum slip rate               = 1e-12
    set Characteristic slip distance    = 0.04
    set Reference friction coefficients = background:0.6, weak:0.7, strong:0.8
    set Direct effect parameters        = background:0.02, weak:0.03, strong:0.04
    set Evolution effect parameters     = background:0.04, weak:0.05, strong:0.06
    set Use regularized formulation     = true
  end
end

subsection Postprocess
  set List of postprocessors = particles, verify fault friction
end
