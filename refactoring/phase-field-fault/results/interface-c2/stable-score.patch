+    // rotating them so that angle-dependent roundoff cannot select the plane.
+    const double mean = m[2]>0. ?
+                        (m[6]/m[8]-m[0]/m[2])*s + (m[7]/m[8]-m[1]/m[2])*c + root.rate*(GBh_ds/m[2]) :
+                        (m[6]*s+m[7]*c)/m[8]-f;
     return {centered[0] *s *s+2.*centered[1] *s *c+centered[2] *c *c+m[8] *mean*mean,f};
   }
 }
