# One growing seed in a 2 m by 1 m box. Time and distance are in seconds and metres.
# Its center (xc,yc) is (1,0.5) m. The initial tangent (tx,ty) points 30 degrees
# counterclockwise from +x; the normal (-ty,tx) points to its left.
# Along-seed coordinate s = tx*(x-xc) + ty*(y-yc).
# Across-seed coordinate n = -ty*(x-xc) + tx*(y-yc).
set Dimension = 2
set End time = 0.005
set Use years instead of seconds = false
set Nonlinear solver scheme = single Advection, iterated Newton Stokes
set Max nonlinear iterations = 80
set Nonlinear solver failure strategy = abort program
set Nonlinear solver tolerance = 1e-9
set Maximum time step = 0.005
set Maximum first time step = 0.005
# Preserve the original ASPECT pressure datum for checkpoint compatibility.
# The adiabatic function below supplies the compression used by friction.
set Surface pressure = 200
set Pressure normalization = no
set Output directory = output-growing-seed
subsection Geometry model
 set Model name = box
 subsection Box
  set X extent = 2
  set Y extent = 1
  set X repetitions = 8
  set Y repetitions = 4
 end
end
subsection Gravity model
 set Model name = vertical
 subsection Vertical
  set Magnitude = 0
 end
end
subsection Temperature field
 set Temperature method = static
end
subsection Initial temperature model
 set List of model names = function
 subsection Function
  set Function expression = 293
 end
end
subsection Compositional fields
 set Number of fields = 1
 set Names of fields = phase_field
 set Types of fields = phase field
 set Compositional field methods = midpoint fault phase
end
subsection Discretization
 set Composition polynomial degree = 2
 set Use discontinuous composition discretization = true
end
subsection Initial composition model
 set List of model names = function
 subsection Function
  set Variable names = x,y
  # The seed tapers to zero along +s at length, and across n at +/-width.
  # peak is dimensionless; xc, yc, length and width are in metres.
  set Function constants = xc=1, yc=0.5, tx=0.86602540378443871, ty=0.49999999999999994, \
                           peak=0.2, length=0.5, width=0.25
  set Function expression = peak * max(0, 1 - (max(0, tx*(x-xc) + ty*(y-yc))/length)^2) \
                                 * max(0, 1 - ((-ty*(x-xc) + tx*(y-yc))/width)^2)
 end
end
subsection Material model
 set Model name = phase field fault
 subsection Phase field fault
  set Friction normal stress = adiabatic pressure
  set Shear modulus = 1e6
  set Viscosity = 1e8
  set Resistance law = rate and state
  set Initial age = 10
  set Reference friction coefficient = .6
  set Direct effect = .015
  set Evolution effect = .02
  set Reference speed = .001
  set Slip distance = .01
  set Radiation damping = 1000
  # To translate or rotate the seed, change xc,yc,tx,ty in BOTH functions,
  # set this angle in degrees, and set the tip to (xc+length*tx,yc+length*ty).
  set Seed tangent angle = 30
  set Forward seed tip = 1.4330127018922194,0.75
  set Cohesion = 1000
 end
end
subsection Mesh refinement
 set Initial global refinement = 0
 set Initial adaptive refinement = 0
 set Time steps between mesh refinement = 0
end
subsection Boundary velocity model
 set Prescribed velocity boundary indicators = left:function, right:function, bottom:function, top:function
 subsection Function
  set Variable names = x,y,t
  # Extension and shear are rates (1/s). In the seed frame,
  # v_s = shear*n + extension*s, v_n = -extension*n.
  # Rotate into Cartesian components (m/s): tx*v_s - ty*v_n; ty*v_s + tx*v_n.
  set Function constants = xc=1, yc=0.5, tx=0.86602540378443871, ty=0.49999999999999994, \
                           extension=0.003, shear=0.020
  set Function expression = tx*(shear*(-ty*(x-xc) + tx*(y-yc)) + extension*(tx*(x-xc) + ty*(y-yc))) \
                          - ty*(-extension*(-ty*(x-xc) + tx*(y-yc))); \
                            ty*(shear*(-ty*(x-xc) + tx*(y-yc)) + extension*(tx*(x-xc) + ty*(y-yc))) \
                          + tx*(-extension*(-ty*(x-xc) + tx*(y-yc)))
 end
end
subsection Solver parameters
 subsection Stokes solver parameters
  # The midpoint solver needs separate velocity and pressure blocks. It gathers
  # the bordered system on MPI rank zero and factors it there with UMFPACK.
  set Stokes solver type = block AMG
 end
end
subsection Phase field
 set Crack geometry = AT1
 set Phase composition = phase_field
 set Fracture energy = 26.6666666667
 set Length scale = .25
end
subsection Adiabatic conditions model
  set Model name = function
  subsection Function
    set Variable names = depth
    # Friction uses p0 (Pa) plus dp_dz (Pa/m) times depth.
    # Set dp_dz=50 for the depth-dependent profile.
    set Function constants = p0=200, dp_dz=0
    # Temperature (K), pressure (Pa), density (kg/m^3). Depth increases down in metres.
    set Function expression = 293; p0 + dp_dz*depth; 1
  end
end
subsection Postprocess
  set List of postprocessors = phase field fault history
end
