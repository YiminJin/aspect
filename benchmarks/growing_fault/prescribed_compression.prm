# One 5 ms step on the nine-strip mesh. Positive normal compression is in Pa.
include onecut.prm
set End time = 0.005
set Output directory = output-prescribed-compression
# Supply compression directly for this experiment.
set Surface pressure =
subsection Material model
  set Model name = phase field fault
  subsection Phase field fault
    set Friction normal stress = prescribed constant
    set Prescribed fault compression = 250
  end
end
# Use the exporter installed beside this input. Each rank writes its native points.
subsection Postprocess
  set List of postprocessors = phase field fault history
end
