include production.prm
# Full physical domain with coarser resolution. Keep transition endpoints.
set Output directory = intermediate-output
set End time = 1600
subsection Mesh refinement
  set Initial global refinement = 6
end
subsection Material model
  subsection Phase field fault
    set Fault vertex file = intermediate-vertices.txt
    # ceil(R + (sin(60)+cos(60))*31.25 m).
    set Profile half width = 83
  end
end
subsection Postprocess
  set List of postprocessors = BP3 stations, BP3 first event profiles, BP3 startup cuts, velocity statistics, visualization, fault slip output
  subsection Visualization
    set Time between graphical output = 0
  end
  subsection BP3 profiles
    set Time interval = 0
  end
end
