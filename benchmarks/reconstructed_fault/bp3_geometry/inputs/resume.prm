include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/bp3_geometry/inputs/base.prm
set Output directory = $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/bp3_geometry/output-resume
set Resume computation = true
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Gap = 6e-8
  end
 end
end
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Staggered = true
  end
 end
end
