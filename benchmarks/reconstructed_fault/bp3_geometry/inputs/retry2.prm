include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/bp3_geometry/inputs/base.prm
set Output directory = $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/bp3_geometry/output-retry2
set Resume computation = true
set Nonlinear solver failure strategy = cut timestep size
subsection Postprocess
 subsection Coupled replenishment
  set Reject step = 2
 end
end
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Gap = 6e-8
  end
 end
end
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Staggered = true
  end
 end
end
