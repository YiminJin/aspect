# 4096 cells, 36864 particles; initialization only, no physical time evolution.
# The shell runner supplies the matched library and a new output directory.
include $ASPECT_SOURCE_DIR/tests/phase_field_fault_stage_i.prm
set Resume computation = false
set Nonlinear solver failure strategy = abort program
subsection Solver parameters
  subsection Stokes solver parameters
    set Stokes solver type = block GMG
    set Stokes GMG type = local smoothing
  end
end
