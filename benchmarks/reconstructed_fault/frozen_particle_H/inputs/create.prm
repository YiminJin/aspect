include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/frozen_particle_H/inputs/base.prm
set Output directory = $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/frozen_particle_H/output-create
set End time = 100
subsection Postprocess
 subsection BP3
 set Last accepted step = 1
 end
end
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Gap = 6e-8
  end
 end
end
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Staggered = true
  end
 end
end
