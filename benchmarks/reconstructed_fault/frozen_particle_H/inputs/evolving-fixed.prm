include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/frozen_particle_H/inputs/evolving-base.prm
set Additional shared libraries = $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/frozen_particle_H/build/observer/libevolving_birth_guard.release.so
set Output directory = $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/frozen_particle_H/output-evolving-fixed
subsection Mesh refinement
 set Initial global refinement = 3
end
subsection Material model
 subsection Phase field fault
  set Evolve phase field = true
 end
end
subsection Particles
 set List of particle properties = BP3 frozen crack driving force, initial composition, maxwell stress
end
subsection Postprocess
 set List of postprocessors = particles, evolving birth guard
end
