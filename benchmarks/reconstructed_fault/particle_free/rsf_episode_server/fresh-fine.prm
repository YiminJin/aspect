include physics.prm
set Output directory = ./fresh-fine-output
set Resume computation = false
subsection Termination criteria
 set Termination criteria = end time, end step, user request, wall time
 set Wall time = 1.5
end
subsection Geometry model
 subsection Box
  set X repetitions = 256
  set Y repetitions = 192
 end
end
subsection Cohesive RSF pilot
 set Seed cells = 192
 set Future surface spacing = .03125
end
