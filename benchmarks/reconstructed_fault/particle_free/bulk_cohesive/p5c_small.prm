include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/particle_free/bulk_cohesive/native.prm
set Additional shared libraries = $ASPECT_SOURCE_DIR/build-particle-free/p5c-native/plugin/libbulk_p5c_checks.release.so
set Output directory = $ASPECT_SOURCE_DIR/build-particle-free/p5c-native/runs/small
set End time = 1
set Maximum time step = 0.0125
set Maximum first time step = 0.0125
subsection Geometry model
  set Model name = box
 subsection Box
 set X extent = 0.25
 set Y extent = 0.25
 set X repetitions = 8
 set Y repetitions = 8
 end
end
subsection Material model
  subsection Phase field fault
    set Bulk cohesive flow rule = in-plane radial tensor
    set Critical energy release rates = 1, 1
    set Cohesions = 2000, 2000
    set FE bulk normal quadrature points = 8
  end
end
subsection Boundary velocity model
  set Prescribed velocity boundary indicators = left:p5c loading, right:p5c loading, bottom:p5c loading, top:p5c loading
end
subsection Postprocess
  set List of postprocessors = particles, p5c checks
end

subsection Phase field model
 set Length scale = 0.046875
end
subsection Time stepping
 set List of model names = bulk cohesive steps
end
subsection Checkpointing
 set Steps between checkpoint = 1
end
subsection Termination criteria
 set Termination criteria = end step
 set End step = 64
end
