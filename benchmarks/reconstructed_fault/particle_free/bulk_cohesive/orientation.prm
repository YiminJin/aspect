include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/particle_free/bulk_cohesive/right_distance.prm
set Additional shared libraries = $ASPECT_SOURCE_DIR/build-particle-free/bulk-orientation/plugin/libbulk_orientation_checks.release.so
set Output directory = $ASPECT_SOURCE_DIR/build-particle-free/bulk-orientation/runs/rotated
# Bounded interval: reference first cap growth .1375 s, stop three steps later.
set End time = 0.145
subsection Geometry model
  set Model name = bulk rotated patch
  subsection Initial topography model
    # The identically zero function selects the existing MappingQ1 path.
    # ZeroTopography would select MappingCartesian, invalid on this mesh.
    set Model name = function
    subsection Function
      set Function expression = 0
    end
  end
end
subsection Postprocess
  set List of postprocessors = particles, bulk cohesive checks, bulk orientation audit
end
