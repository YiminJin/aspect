include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/particle_lifecycle/inputs/base.prm
set Output directory = $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/particle_lifecycle/output-final-direct2-fixed
set Resume computation = true
subsection Postprocess
 subsection Coupled replenishment
  set Resume interval = 50
 end
end
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Gap = 6e-8
  end
 end
end
subsection Particles
 subsection Generator
  subsection Crossing reference cell
   set Staggered = true
  end
 end
end
