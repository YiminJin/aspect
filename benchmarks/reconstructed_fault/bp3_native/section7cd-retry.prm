include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/bp3_native/section7cd-bulk.prm
set Additional shared libraries = $ASPECT_SOURCE_DIR/build-bp3-native/section7b/bp3-plugin/libbp3_restore_150x50.release.so, $ASPECT_SOURCE_DIR/build-bp3-native/section7cd/mpi-plugin/libbp3_coupled_checks.release.so
set End time = 600000
subsection Postprocess
  subsection BP3
    set Last accepted step = 3
    set Graceful wall seconds = 590
  end
  subsection BP3 coupled checks
    set Write FE coefficients = true
  end
end
set Output directory = $ASPECT_SOURCE_DIR/build-bp3-native/runs/7cd-retry
subsection Postprocess
  subsection BP3 coupled checks
    set Inject candidate failure = true
  end
end
