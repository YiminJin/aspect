# The single targeted comparison: halve the active state-change timestep bound.
# Initial data, initial constitutive interval, geometry, mesh, quadrature,
# particles, friction, physical loading, filter and solver tolerances match.
include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/bp3_native/slip-front.prm
set Output directory = $ASPECT_SOURCE_DIR/build-bp3-native/slip-front/runs/comparison
subsection Time stepping
  subsection Reconstructed fault time step
    set Maximum logarithmic state change = 0.1
  end
end
subsection Postprocess
  subsection BP3
    set Last accepted step = 240
    set Graceful wall seconds = 1800
  end
end
