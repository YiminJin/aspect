include $ASPECT_SOURCE_DIR/benchmarks/reconstructed_fault/bp3_native/transport/base.prm
set Output directory = $ASPECT_SOURCE_DIR/build-bp3-native/transport-checks/runs/shear-dt03125
set Maximum time step = 0.03125
set Maximum first time step = 0.03125
subsection Mesh refinement
  set Initial global refinement = 3
end
subsection Particles
  subsection Generator
    subsection Reference cell
      set Number of particles per cell per direction = 8
    end
  end
end
subsection Prescribed Stokes solution
  subsection Velocity function
    set Function expression = 0.4+0.2*t*(y-0.5); 0
  end
end
subsection Postprocess
  subsection Prescribed transport
    set Shear rate ramp = 0.2
  end
end
