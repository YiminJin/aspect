# The uniform preload and sector controls share initial stress and wall velocities.
include granite_preload_reference.prm
set Output directory = output-granite-sector
subsection Geometry model
  subsection Box
    set X repetitions = 12
    set Y repetitions = 6
  end
end
subsection Material model
  subsection Phase field fault
    set Target strip width = 0.015625
  end
end
subsection Mesh refinement
  set Initial adaptive refinement = 3
  set Skip solvers on initial refinement = true
  set Skip setup initial conditions on initial refinement = true
  set Refinement fraction = 0.01
  set Coarsening fraction = 0
  set Strategy = growing fault
  subsection Growing fault
    set Coverage = forward sector
  end
end
